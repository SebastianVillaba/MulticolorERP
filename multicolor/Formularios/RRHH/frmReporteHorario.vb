    '------------------------------------------------------------------------------------------------------------------
    '*************'
    '-- BOTONES --'
    '*************'
    Private Sub btnBuscar_Click(sender As System.Object, e As System.EventArgs) Handles btnBuscar.Click
        banGl_reporteHorarioPersonal = True
        Me.Enabled = False

        frmBuscarSucursal.txtBuscar.Text = ""
        frmBuscarSucursal.txtId.Text = 0
        frmBuscarSucursal.txtNombre.Text = ""
        frmBuscarSucursal.Show()
        frmBuscarSucursal.BringToFront()
        frmBuscarSucursal.txtBuscar.Focus()
    End Sub

    Private Sub btnConsultar_Click(sender As System.Object, e As System.EventArgs) Handles btnConsultar.Click
        Me.Enabled = False

        If rdResumen.Checked = True Then
            If Not IsNumeric(txtIdSucursal.Text) Then
                MessageBox.Show("Debe Seleccionar una Sucursal..!", strGl_nombreSistema, MessageBoxButtons.OK, MessageBoxIcon.Warning)
                Me.Enabled = True
                Exit Sub
            End If
            '-- todos los personales de todas las sucursales
            Me.Enabled = False
            imprimirPersonal()
            Me.Enabled = True
        End If
        If rdDetalle.Checked = True Then
            '-- detalle por personal en todas las sucursales
            imprimirPersonalDetalle()
        End If

        If rdTodoPersonal.Checked = True Then
            '-- detalle de todos los personales
            imprimirPersonalDetalleTodos()
        End If

        Me.Enabled = True

    End Sub
